# LLM provider: "openai" or "groq"
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=sk-your-openai-api-key

# Agentic RAG tool toggles (see README.md > Agentic RAG Architecture)
AGENT_WEB_SEARCH_ENABLED=true
AGENT_TICKET_TOOL_ENABLED=true
AGENT_RECURSION_LIMIT=10
AGENT_KB_TOP_K=5

