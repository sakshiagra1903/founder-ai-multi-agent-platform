# Application
APP_NAME="Founder AI - Feedback Agent"
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/founder_ai_feedback
DATABASE_SYNC_URL=postgresql://postgres:password@localhost:5432/founder_ai_feedback

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Provider — switch between: groq / ollama / huggingface
LLM_PROVIDER=groq

# Groq (Free Tier) — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Ollama (local, completely free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# HuggingFace
HUGGINGFACE_API_KEY=your-hf-token
HF_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Sentiment Model (free HuggingFace)
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

# Embedding Model (free)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Topic Modeling
TOPIC_MODEL_TYPE=bertopic

# File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

