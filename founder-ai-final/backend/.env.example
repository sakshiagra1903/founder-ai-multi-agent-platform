APP_NAME=Founder AI - Hiring Agent
APP_ENV=development
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database: SQLite (default, zero setup) or PostgreSQL
DATABASE_URL=sqlite:///./founderai.db
# DATABASE_URL=postgresql://user:password@localhost:5432/founderai

# AI Provider: Groq (free, recommended) or OpenAI (paid)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=sk_your_openai_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_MODEL=gpt-4o-mini

# AI_MODE: "agentic" (default) = LangGraph multi-agent RAG pipeline — deeper,
#          more accurate, ~6-8 LLM calls per resume, slower/costlier.
#          "simple" = original single-prompt evaluator — 1 LLM call, fast.
AI_MODE=agentic

# Local embedding model for RAG (downloaded once from Hugging Face on first
# run, then cached — no API key needed). Change only if you know what you're doing.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIR=chroma_db

MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

