# Where the 3 EXISTING, unchanged agent backends are reachable.
# (Their internal ports stay 8000 each inside their own containers/venvs —
# these are just how the orchestrator reaches them; see root docker-compose.)
FEEDBACK_AGENT_URL=http://feedback-backend:8000
HIRING_AGENT_URL=http://hiring-backend:8000
SUPPORT_AGENT_URL=http://support-backend:8000

# Supervisor LLM (does real multi-step reasoning + decides which agent
# tool(s) to call, possibly more than one, in sequence)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
SUPERVISOR_MODEL=openai/gpt-oss-120b

# Or set LLM_PROVIDER=openai and fill these instead
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ALLOWED_ORIGINS=["http://localhost:3000"]

